PORT=3100
NODE_ENV=development
# Local SQLite works without accounts. Hosted production requires Atlas.
MONGODB_URI=
MONGODB_DATABASE=sidequest
# OpenAI-compatible Gemma inference endpoint (e.g. your DigitalOcean service).
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
SERPAPI_API_KEY=
# Optional venue corpus: run npm run setup:venues before enabling.
TIGER_DATABASE_URL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# A separate worker shares Atlas with the web app.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
SENTRY_DSN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BACKBOARD_API_KEY=
# JSON, e.g. [{"provider":"openrouter","model":"your-selected-open-model"}]
BACKBOARD_MODELS=
TINKER_API_KEY=
DIGITALOCEAN_ACCESS_TOKEN=
ARDUINO_DEVICE_TOKEN=
