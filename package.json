{
  "name": "sidequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "check:temporal": "node scripts/temporal-check.mjs",
    "setup:venues": "node --env-file-if-exists=.env scripts/setup-venue-index.mjs",
    "eval:backboard": "node --env-file-if-exists=.env scripts/backboard-eval.mjs"
  },
  "dependencies": {
    "@mastra/core": "^1.74.0",
    "@sentry/node": "^11.4.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@temporalio/testing": "^1.24.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
